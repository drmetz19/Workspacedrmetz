# ── Database ─────────────────────────────────────────────
# Lokal: Postgres 16. Produksi: connection string Supabase (Settings → Database).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/csse_dev

# ── Aplikasi ─────────────────────────────────────────────
APP_URL=http://localhost:3000
# Email Owner pertama (dibuat oleh `pnpm db:seed` bila belum ada Owner)
CSSE_BOOTSTRAP_OWNER_EMAIL=owner@drmetz.test
CSSE_BOOTSTRAP_OWNER_NAME=dr. Metz

# ── Identity provider ────────────────────────────────────
# local    = provider pengembangan (password di DB lokal + simulasi login Google). JANGAN dipakai di produksi.
# supabase = Supabase Auth (Google OAuth + email/password)
IDENTITY_PROVIDER=local
CSSE_ALLOW_DEV_IDP=1
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Email ────────────────────────────────────────────────
# outbox = email disimpan di tabel email_outbox (dev/smoke test)
# smtp   = dikirim lewat SMTP (produksi: Gmail projectcuan15@gmail.com + App Password) + salinan di outbox
EMAIL_PROVIDER=outbox
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# App Password Google (Akun Google → Keamanan → Verifikasi 2 langkah → Sandi aplikasi), BUKAN password Gmail biasa
SMTP_PASS=
# opsional; default: "Dr. Metz Workspace" <SMTP_USER>
EMAIL_FROM=

# ── Google Drive ─────────────────────────────────────────
# link   = dokumen cukup tautan Drive; izin file dari setelan berbagi Drive (PRODUKSI — tanpa akun service/scan)
# mock   = isi folder dari tabel dev_drive_files (pengembangan/test)
# google = Google Drive API v3 dengan akun service (opsional)
DRIVE_PROVIDER=mock
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_IMPERSONATE_SUBJECT=
# Rahasia untuk endpoint cron (/api/cron/*), dikirim Vercel Cron sebagai Bearer token
CRON_SECRET=

# ── AI (lewat adapter; ganti provider tanpa mengubah service) ─
# none = AI nonaktif · mock = deterministik (dev/test) · anthropic = Claude
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
