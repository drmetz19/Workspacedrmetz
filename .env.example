# ── Database ─────────────────────────────────────────────
# Lokal: Postgres 16. Produksi: connection string Supabase (Settings → Database).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/csse_dev

# ── Aplikasi ─────────────────────────────────────────────
APP_URL=http://localhost:3000
# Email Owner pertama (dibuat oleh `pnpm db:seed` bila belum ada Owner)
CSSE_BOOTSTRAP_OWNER_EMAIL=owner@drmetz.test
CSSE_BOOTSTRAP_OWNER_NAME=dr. Metz

# ── Identity provider ────────────────────────────────────
# local    = provider pengembangan (password di DB lokal + simulasi login Google). JANGAN dipakai di produksi.
# supabase = Supabase Auth (Google OAuth + email/password)
IDENTITY_PROVIDER=local
CSSE_ALLOW_DEV_IDP=1
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Email ────────────────────────────────────────────────
# outbox = email disimpan di tabel email_outbox (dev/smoke test)
EMAIL_PROVIDER=outbox
